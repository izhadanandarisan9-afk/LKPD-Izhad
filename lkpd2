<script>
function show(id, text) {
  document.getElementById(id).textContent = text;
}

function rupiah(n) {
  return "Rp " + Number(n).toLocaleString("id-ID");
}

function runA1() {
  let a = 10;
  let b = 5;
  show("out1",
    "a + b = " + (a+b) +
    "\na - b = " + (a-b) +
    "\na * b = " + (a*b) +
    "\na / b = " + (a/b)
  );
}

function runA2() {
  let a = 20;
  let b = 4;
  show("out2",
    "a + b = " + (a+b) +
    "\na - b = " + (a-b) +
    "\na * b = " + (a*b) +
    "\na / b = " + (a/b) +
    "\na % b = " + (a%b)
  );
}

function runA3() {
  let nama = prompt("Masukkan nama:","Izhad");
  if (nama === null) return;

  let umur = prompt("Masukkan umur:","16");
  if (umur === null) return;

  show("out3", "Nama: " + nama + "\nUmur: " + umur);
}

function hitungUmur() {
  let tahun = Number(document.getElementById("lahir").value);

  if (!tahun || tahun < 1900 || tahun > 2026) {
    show("out4", "Masukkan tahun lahir antara 1900–2026.");
    return;
  }

  show("out4",
    "Umur = 2026 - " + tahun +
    " = " + (2026-tahun) + " tahun."
  );
}

function kasirMini() {
  let harga = Number(document.getElementById("harga5").value);
  let jumlah = Number(document.getElementById("jumlah5").value);

  if (harga < 0 || jumlah < 0) {
    show("out5", "Harga dan jumlah tidak boleh negatif.");
    return;
  }

  show("out5",
    "Harga: " + rupiah(harga) +
    "\nJumlah: " + jumlah +
    "\nTotal: " + rupiah(harga * jumlah)
  );
}

function warung() {
  let makanan = document.getElementById("makanan7").value || "Makanan";
  let harga = Number(document.getElementById("harga7").value);
  let jumlah = Number(document.getElementById("jumlah7").value);

  if (harga < 0 || jumlah < 0) {
    show("out7", "Harga dan jumlah tidak boleh negatif.");
    return;
  }

  let total = harga * jumlah;
  let diskon = total * 10 / 100;
  let bayar = total - diskon;

  show("out7",
    "Nama makanan: " + makanan +
    "\nHarga satuan: " + rupiah(harga) +
    "\nJumlah: " + jumlah +
    "\nTotal: " + rupiah(total) +
    "\nDiskon 10%: " + rupiah(diskon) +
    "\nTotal bayar: " + rupiah(bayar)
  );
}

function debugging() {
  let harga = 5000;
  let jumlah = 3;
  let totalHarga = harga * jumlah;

  show("out8",
    "totalHarga = harga × jumlah" +
    "\n= 5000 × 3" +
    "\nOutput: " + totalHarga
  );
}

function tabungan() {
  let awal = Number(document.getElementById("awal9").value);
  let hari1 = Number(document.getElementById("hari19").value);
  let hari2 = Number(document.getElementById("hari29").value);
  let hari3 = Number(document.getElementById("hari39").value);

  if ([awal, hari1, hari2, hari3].some(n => n < 0)) {
    show("out9", "Tabungan tidak boleh negatif.");
    return;
  }

  let total = awal + hari1 + hari2 + hari3;

  show("out9",
    "Uang awal: " + rupiah(awal) +
    "\nHari pertama: " + rupiah(hari1) +
    "\nHari kedua: " + rupiah(hari2) +
    "\nHari ketiga: " + rupiah(hari3) +
    "\nTotal tabungan: " + rupiah(total)
  );
}
</script>

