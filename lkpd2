<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LKPD JavaScript - Midnight Teal</title>
<style>
:root{--bg:#0a1020;--card:#111a30;--card2:#18243f;--line:#263759;--tx:#e8eefb;--mut:#a3b3d1;--a:#2dd4bf;--b:#818cf8;--ok:#34d399}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(900px 500px at 10% -10%,#1b2a5a55,transparent),radial-gradient(800px 500px at 100% 0,#0f766e44,transparent),var(--bg);font-family:"Segoe UI",system-ui,Arial,sans-serif;color:var(--tx);line-height:1.65}
header{text-align:center;padding:56px 20px 40px}
.chip{display:inline-block;padding:5px 16px;border:1px solid var(--line);border-radius:99px;background:#ffffff08;color:var(--a);font-size:13px;letter-spacing:.08em;margin:0}
header h1{font-size:clamp(30px,6vw,52px);margin:14px 0 6px;background:linear-gradient(90deg,var(--a),var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
header h3{margin:0;color:var(--tx);font-weight:500}
header p.sub{color:var(--mut);margin:10px 0 0}
nav{position:sticky;top:10px;z-index:5;display:flex;gap:6px;overflow-x:auto;max-width:900px;margin:0 auto;padding:8px;background:#0a1020cc;backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:99px}
nav a{white-space:nowrap;text-decoration:none;color:var(--mut);font-weight:600;font-size:14px;padding:7px 14px;border-radius:99px}
nav a:hover{background:linear-gradient(90deg,var(--a),var(--b));color:#06101f}
main{max-width:960px;margin:28px auto;padding:0 16px 40px}
.card{position:relative;background:linear-gradient(180deg,var(--card),#0e1627);border:1px solid var(--line);border-radius:20px;padding:24px;margin:20px 0;box-shadow:0 14px 40px #00000055;overflow:hidden}
.card::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--a),var(--b))}
h2{margin:4px 0 14px;font-size:22px;color:var(--tx)}
h2::before{content:"✦";color:var(--a);margin-right:10px}
h3{color:var(--a);margin:6px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}
.mini{background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:16px}
pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#050a14;color:#7ef5e1;font-family:Consolas,"Courier New",monospace;font-size:14px;padding:14px 16px;border-radius:12px;border:1px solid #1d2c4a;border-left:4px solid var(--a);overflow-x:auto}
button{border:none;border-radius:12px;padding:11px 18px;background:linear-gradient(90deg,var(--a),var(--b));color:#06101f;font-weight:700;cursor:pointer;margin:8px 4px 8px 0;transition:.2s}
button:hover{transform:translateY(-2px);box-shadow:0 8px 20px #2dd4bf33}
.secondary{background:transparent;color:var(--a);border:1px solid var(--a)}
label{display:block;font-weight:600;color:var(--mut);margin:10px 0 5px;font-size:14px}
input,textarea,select{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px 12px;font:inherit;background:#0a1224;color:var(--tx)}
input:focus,textarea:focus,select:focus{outline:2px solid var(--a);border-color:transparent}
textarea{min-height:78px;resize:vertical}
.output{background:#07101f;border:1px dashed var(--a);border-radius:12px;padding:14px;min-height:48px;margin-top:8px;white-space:pre-wrap;font-family:Consolas,"Courier New",monospace;color:#bff7ee}
.answer{border-left:4px solid var(--ok);background:#34d3990f;padding:12px 16px;border-radius:0 12px 12px 0;margin:14px 0}
.answer b{color:var(--ok)}
table{width:100%;border-collapse:separate;border-spacing:0;margin:12px 0;border:1px solid var(--line);border-radius:12px;overflow:hidden}
th,td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:0}
th{background:var(--card2);color:var(--a)}
details{background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:12px 16px;margin:12px 0}
summary{cursor:pointer;font-weight:700;color:var(--tx)}
footer{text-align:center;padding:28px;color:var(--mut)}
@media(max-width:600px){.card{padding:18px}nav a{font-size:13px;padding:6px 10px}table{font-size:13px}}
@media print{body{background:#fff;color:#000}.card,.mini,details{box-shadow:none;background:#fff;color:#000}nav,button{display:none}header h1{color:#000;-webkit-text-fill-color:#000}}
</style>
</head>
<body>

